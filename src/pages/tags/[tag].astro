---
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths(){
    const allPosts = Object.values(import.meta.glob('../posts/*.md', {eager: true}));

    const uniqueTags = [...new Set(allPosts.map((post: any)=> post.frontmatter.tags).flat())];

    return uniqueTags.map((tag) => {
        const filteredPosts = allPosts.filter((post: any) => post.frontmatter.tags.includes(tag));
        return {
            params: { tag },
            props: { posts: filteredPosts }
        }
    });
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---
<BaseLayout pageTitle={`タグ: ${tag}`}>
    <p class="intro">「{tag}」タグが付いた記事一覧です。</p>

    <div class="blog-list">
        {posts.map((post: any) => (
            <article class="blog-card">
                <a href={post.url} class="blog-link">
                    {post.frontmatter.image && (
                        <img
                            src={post.frontmatter.image.url}
                            alt={post.frontmatter.image.alt}
                            class="blog-image"
                        />
                    )}
                    <div class="blog-content">
                        <h2>{post.frontmatter.title}</h2>
                        <p class="blog-date">{new Date(post.frontmatter.pubDate).toLocaleDateString('ja-JP')}</p>
                        <p class="blog-description">{post.frontmatter.description}</p>
                    </div>
                </a>
            </article>
        ))}
    </div>

    <div class="back-link-container">
        <a href="/tags" class="back-link">← すべてのタグを見る</a>
    </div>
</BaseLayout>

<style>
    .intro {
        font-size: 1.1rem;
        color: var(--color-text-light);
        margin-bottom: 2rem;
    }

    .blog-list {
        display: grid;
        gap: 2rem;
        margin-bottom: 3rem;
    }

    .blog-card {
        background: white;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .blog-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    }

    .blog-link {
        display: grid;
        grid-template-columns: 200px 1fr;
        gap: 1.5rem;
        text-decoration: none;
        color: inherit;
    }

    .blog-image {
        width: 200px;
        height: 150px;
        object-fit: cover;
    }

    .blog-content {
        padding: 1.5rem 1.5rem 1.5rem 0;
    }

    .blog-card h2 {
        margin: 0 0 0.5rem;
        font-size: 1.5rem;
        color: var(--color-text);
    }

    .blog-date {
        font-size: 0.9rem;
        color: var(--color-text-light);
        margin: 0 0 0.75rem;
    }

    .blog-description {
        color: var(--color-text-light);
        line-height: 1.6;
        margin: 0;
    }

    .back-link-container {
        padding-top: 2rem;
        border-top: 1px solid var(--color-bg-section);
    }

    .back-link {
        color: var(--color-programming);
        text-decoration: none;
        font-weight: 500;
    }

    .back-link:hover {
        text-decoration: underline;
    }

    @media (max-width: 768px) {
        .blog-link {
            grid-template-columns: 1fr;
        }

        .blog-image {
            width: 100%;
            height: 200px;
        }

        .blog-content {
            padding: 1.5rem;
        }
    }
</style>