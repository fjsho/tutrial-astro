---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "About";

const profile = {
  name: "Tech Blog 運営者",
  occupation: "ITエンジニア",
  specialties: ["Web開発", "フロントエンド", "バックエンド"],
};

const skills = [
  "JavaScript/TypeScript",
  "React",
  "Node.js",
  "Python",
  "AWS",
  "Docker",
];
---

<BaseLayout pageTitle={pageTitle}>
  <section class="profile">
    <h2>プロフィール</h2>
    <p>
      ITエンジニアとして日々の学びや経験を記録しています。<br />
      技術的な課題の解決方法や、役立つガジェット・書籍の情報を共有することで、
      他のエンジニアの方々の参考になれば嬉しいです。
    </p>

    <div class="profile-details">
      <div class="detail-item">
        <h3>専門分野</h3>
        <ul>
          {profile.specialties.map((specialty) => (
            <li>{specialty}</li>
          ))}
        </ul>
      </div>

      <div class="detail-item">
        <h3>主なスキル</h3>
        <ul class="skills-list">
          {skills.map((skill) => (
            <li class="skill-tag">{skill}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="contact">
    <h2>コンタクト</h2>
    <p>
      記事へのフィードバックや質問などがありましたら、
      各種SNSからお気軽にご連絡ください。
    </p>
  </section>
</BaseLayout>

<style>
  .profile {
    margin-bottom: 3rem;
  }

  .profile > p {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-text-light);
    margin: 1.5rem 0;
  }

  .profile-details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .detail-item {
    padding: 1.5rem;
    background-color: white;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .detail-item h3 {
    margin-top: 0;
    margin-bottom: 1rem;
    font-size: 1.25rem;
    color: var(--color-programming);
  }

  .detail-item ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .detail-item li {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-bg-section);
  }

  .detail-item li:last-child {
    border-bottom: none;
  }

  .skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .skill-tag {
    padding: 0.5rem 1rem !important;
    background-color: var(--color-programming);
    color: white;
    border-radius: 20px;
    font-size: 0.9rem;
    font-weight: 500;
    border: none !important;
  }

  .contact {
    padding: 2rem;
    background-color: var(--color-bg-section);
    border-radius: 8px;
  }

  .contact h2 {
    margin-top: 0;
  }

  .contact p {
    color: var(--color-text-light);
    line-height: 1.8;
  }
</style>
