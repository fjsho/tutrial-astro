---
import BaseLayout from "../layouts/BaseLayout.astro";
const allPosts = await Astro.glob('../pages/posts/*.md');
const sortedPosts = allPosts.sort((a: any, b: any) =>
  new Date(b.frontmatter.pubDate).getTime() - new Date(a.frontmatter.pubDate).getTime()
);

const pageTitle = "Blog";
---

<BaseLayout pageTitle={pageTitle}>
  <p class="intro">技術的な学びやプロジェクトの記録を共有しています。</p>

  <div class="blog-list">
    {sortedPosts.map((post: any) => (
      <article class="blog-card">
        <a href={post.url} class="blog-link">
          {post.frontmatter.image && (
            <img
              src={post.frontmatter.image.url}
              alt={post.frontmatter.image.alt}
              class="blog-image"
            />
          )}
          <div class="blog-content">
            <h2>{post.frontmatter.title}</h2>
            <p class="blog-date">{new Date(post.frontmatter.pubDate).toLocaleDateString('ja-JP')}</p>
            <p class="blog-description">{post.frontmatter.description}</p>
            <div class="tags">
              {post.frontmatter.tags.map((tag: string) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </div>
        </a>
      </article>
    ))}
  </div>
</BaseLayout>

<style>
  .intro {
    font-size: 1.1rem;
    color: var(--color-text-light);
    margin-bottom: 2rem;
  }

  .blog-list {
    display: grid;
    gap: 2rem;
  }

  .blog-card {
    background: white;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }

  .blog-link {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 1.5rem;
    text-decoration: none;
    color: inherit;
  }

  .blog-image {
    width: 200px;
    height: 150px;
    object-fit: cover;
  }

  .blog-content {
    padding: 1.5rem 1.5rem 1.5rem 0;
  }

  .blog-card h2 {
    margin: 0 0 0.5rem;
    font-size: 1.5rem;
    color: var(--color-text);
  }

  .blog-date {
    font-size: 0.9rem;
    color: var(--color-text-light);
    margin: 0 0 0.75rem;
  }

  .blog-description {
    color: var(--color-text-light);
    line-height: 1.6;
    margin: 0 0 1rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    padding: 0.25rem 0.75rem;
    background-color: var(--color-programming);
    color: white;
    border-radius: 4px;
    font-size: 0.85rem;
  }

  @media (max-width: 768px) {
    .blog-link {
      grid-template-columns: 1fr;
    }

    .blog-image {
      width: 100%;
      height: 200px;
    }

    .blog-content {
      padding: 1.5rem;
    }
  }
</style>
